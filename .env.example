# ==================================================
# AI-Powered Multi-Document Analysis System (Phase 1)
# Environment Configuration
# ==================================================

# AI Model Credentials
# Obtain Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# Or obtain Groq API Key from Groq Console (https://console.groq.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# RAG & Chunking Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4

# Embedding Model Configuration
# Supported options: "sentence-transformers", "gemini", "openai"
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Provider Configuration
# Supported options: "gemini", "groq", "openai", "mock"
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.8-flash
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Domain System Metadata
DOMAIN_TITLE="Artificial Intelligence & RAG Systems Research Domain"
